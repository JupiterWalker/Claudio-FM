# TTS provider.
TTS_PROVIDER=volcengine
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_RESOURCE_ID=volc.service_type.10029
VOLCENGINE_TTS_VOICE_TYPE=en_female_nadia_tips_emo_v2_mars_bigtts
# Optional station voice for Chinese DJ lines. Claudio falls back to these
# defaults when the DJ language is Chinese and no explicit values are set.
VOLCENGINE_TTS_RESOURCE_ID_ZH=seed-tts-2.0
VOLCENGINE_TTS_VOICE_TYPE_ZH=zh_male_wennuanahu_uranus_bigtts
VOLCENGINE_TTS_FORMAT=mp3
VOLCENGINE_TTS_SAMPLE_RATE=24000
CALLER_TTS_RESOURCE_ID=seed-tts-2.0
CALLER_TTS_VOICE_TYPE=zh_male_wennuanahu_uranus_bigtts

# LLM provider.
LLM_PROVIDER=codex_cli
LLM_TIMEOUT_MS=120000
CODEX_CLI_COMMAND=codex
CODEX_MODEL=
# Optional override for the arguments after CODEX_CLI_COMMAND.
# CODEX_CLI_ARGS=exec --ignore-user-config --sandbox read-only --ephemeral --color never -

# Music provider.
MUSIC_PROVIDER=youtube
# Requires yt-dlp on PATH.

# Optional Netease fallback/compatibility settings. Used only when
# MUSIC_PROVIDER=netease or MUSIC_PROVIDER=auto.
NETEASE_API_BASE=http://127.0.0.1:3000
NETEASE_LEVEL=standard
NETEASE_COOKIE=

# Optional DeepSeek fallback. Used only when LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
